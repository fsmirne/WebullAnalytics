<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>wa-scraper</AssemblyName>
		<RootNamespace>WebullAnalytics.Scraper</RootNamespace>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- install.bat publishes single-file self-contained; without this the embedded native e_sqlite3.dll
		     isn't extracted at startup and SqliteConnection's type initializer throws. -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Spectre.Console" Version="0.57.1" />
		<PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
		<!-- Direct ref so the SQLitePCLRaw native assets (e_sqlite3) land in wa-scraper's output — they don't
		     flow transitively through the project reference for an Exe, which is why SqliteConnection's type
		     initializer threw. -->
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WebullAnalytics.csproj" />
	</ItemGroup>

	<!-- WebullAnalytics.csproj is an Exe, so its ProjectReference flows wa.runtimeconfig.json into publish.
	     The single-file bundler ignores secondary *.runtimeconfig.json files (wa-scraper has its own) and emits
	     NETSDK1236 on .NET 11 SDK; drop it from ResolvedFileToPublish before bundling. -->
	<Target Name="_StripReferencedExeRuntimeConfig" AfterTargets="ComputeFilesToPublish" BeforeTargets="_ComputeFilesToBundle">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'wa.runtimeconfig.json'" />
		</ItemGroup>
	</Target>

</Project>
